{
  "name": "@beltechi/parabola",
  "version": "0.6.0",
  "description": "A style, not a traditional design system: fixed below, free above. Tokens, components and a theme editor any AI can build on.",
  "license": "MIT",
  "homepage": "https://parabolasystem.com",
  "bugs": "https://github.com/alexbeltechi/parabola/issues",
  "keywords": ["design-system", "tokens", "theme", "react", "tailwindcss", "components", "ai"],
  "repository": {
    "type": "git",
    "url": "https://github.com/alexbeltechi/parabola.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "*.ts",
    "*.tsx",
    "tokens.css",
    "primitives",
    "components",
    "blocks",
    "showcase",
    "README.md",
    "LICENSE",
    "docs",
    "bin",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./index.ts",
    "./blocks": "./blocks/index.ts",
    "./primitives/rich-text": "./primitives/rich-text.tsx",
    "./showcase/ds-shell": "./showcase/ds-shell.tsx",
    "./showcase/registry": "./showcase/registry.ts",
    "./tokens.css": "./tokens.css",
    "./package.json": "./package.json"
  },
  "bin": {
    "parabola": "./bin/parabola.mjs"
  },
  "scripts": {
    "bundle": "node scripts/build-cli.mjs",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "tsx scripts/check-tokens.ts",
    "dev": "npm run dev -w site",
    "build:site": "npm run build -w site"
  },
  "devDependencies": {
    "@types/node": "^20",
    "esbuild": "^0.27.7",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "peerDependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.561.0",
    "next": "^16.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@tiptap/extension-placeholder": {
      "optional": true
    },
    "@tiptap/extension-table": {
      "optional": true
    },
    "@tiptap/pm": {
      "optional": true
    },
    "@tiptap/react": {
      "optional": true
    },
    "@tiptap/starter-kit": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  },
  "workspaces": [
    "site"
  ]
}
